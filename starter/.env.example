# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Empty = intfloat/multilingual-e5-small (local, used for the recorded run).
EMBEDDING_MODEL=

# Optional pipeline settings (empty = defaults used for the recorded run).
# VECTOR_STORE: pgvector (default) | chroma
VECTOR_STORE=
# CORPUS_PDF: path to harrypotter.pdf (default: starter/data/raw/harrypotter.pdf; relative = from starter/)
CORPUS_PDF=
# BOOKS: comma-separated book numbers (default: 1,2,3)
BOOKS=
